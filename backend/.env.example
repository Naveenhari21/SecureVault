# ── Backend Environment Variables ──────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git.

PORT=5000
NODE_ENV=production

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT — use a strong random string (min 32 chars)
JWT_SECRET=replace_with_a_long_random_secret_min_32_characters
JWT_EXPIRE=7d

# AES-256-CBC file encryption — exactly 32 chars for key, 16 chars for IV
ENCRYPTION_KEY=replace_with_exactly_32_char_key
ENCRYPTION_IV=replace_16charIV!!

# Max upload file size in bytes (default 50 MB)
MAX_FILE_SIZE=52428800

# Frontend URL for CORS (set this to your Vercel deployment URL)
FRONTEND_URL=https://your-app.vercel.app
